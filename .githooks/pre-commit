#!/bin/bash
# Pre-commit hook : formate automatiquement les fichiers Java stagés avec Spotless
# (Palantir Java Format).
#
# Installé automatiquement par git-build-hook-maven-plugin au premier ./mvnw exécuté
# dans le repo (qui configure core.hooksPath=.githooks).
#
# Comportement :
# - Skip si aucun fichier .java n'est stagé
# - Lance ./mvnw spotless:apply silencieusement (reformate tout le working tree, pas
#   seulement les hunks stagés)
# - Re-stage les fichiers Java qui étaient déjà stagés pour que le reformatage entre
#   dans le commit
# - Si Spotless échoue, le commit passe quand même (on ne bloque pas pour une question
#   de format)
#
# Limitation connue : ce hook NE préserve PAS un `git add -p` partiel. Si un fichier a
# été partiellement stagé, le `git add` final re-stage le fichier complet reformaté.

set -e

# Les deux langues se traitent INDÉPENDAMMENT, et cette indépendance a une raison mesurée (#5022).
# La forme précédente sortait tôt sur `[ -z "$STAGED_JAVA" ] && exit 0`, puis sur un échec de
# Spotless : un commit qui ne touche que du Python n'atteignait donc jamais son formateur. Le défaut
# est passé inaperçu parce qu'AUCUN check de CI n'exécute ce hook ; il a fallu le jouer à la main.

# Python : le pendant de ce que Spotless fait au Java. Même contrat, on formate, on re-stage, et on
# ne BLOQUE PAS le commit sur une question de forme. `ruff check` n'est volontairement pas lancé
# ici : il porte des jugements qu'un commit en cours n'a pas à trancher, et c'est la CI qui les rend.
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
if [ -n "$STAGED_PY" ] && command -v ruff >/dev/null 2>&1; then
  echo "$STAGED_PY" | xargs ruff format --quiet >/dev/null 2>&1 || true
  echo "$STAGED_PY" | xargs git add
fi

# Java : Spotless, comme avant.
STAGED_JAVA=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.java$' || true)
if [ -n "$STAGED_JAVA" ] && ./mvnw -q spotless:apply >/dev/null 2>&1; then
  echo "$STAGED_JAVA" | xargs git add
fi

exit 0
