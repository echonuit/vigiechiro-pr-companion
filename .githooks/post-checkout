#!/bin/bash
# Post-checkout hook : nettoie target/ après un changement de branche pour éviter
# les classes compilées périmées (l'ancienne branche laisse ses .class dans
# target/, ce qui fausse tests, PMD et lancements suivants).
#
# Installé automatiquement par git-build-hook-maven-plugin au premier ./mvnw exécuté
# dans le repo (qui configure core.hooksPath=.githooks).
#
# Arguments fournis par git :
# - $1 : ancien HEAD
# - $2 : nouveau HEAD
# - $3 : 1 pour un checkout de branche, 0 pour un checkout de fichier
#
# Comportement :
# - Skip si ce n'est pas un vrai changement de branche (checkout de fichier,
#   HEAD inchangé, checkout initial d'un clone ou d'un worktree add)
# - Skip si le diff entre les deux HEAD ne touche ni src/ ni pom.xml
#   (changement doc-only : target/ reste valide, inutile de recompiler)
# - Sinon lance ./mvnw -q clean, en silence et sans bloquer : si le clean échoue
#   (typiquement le language server de l'IDE qui recompile dans target/ au même
#   moment), une seule ligne d'avertissement remplace le mur d'erreurs Maven

[ "$3" = "1" ] || exit 0
[ "$1" != "$2" ] || exit 0
# Le SHA nul dit un checkout INITIAL : un clone, ou un `git worktree add`. Il n'y a alors pas de
# target/ a nettoyer - mais c'est exactement le moment ou l'arbre neuf n'a aucun des outils que ses
# gardes reclament, et ou personne n'attend. On pose, puis on sort (#5406).
#
# La logique vit en Python : ce dispositif n'a AUCUN gardien en CI - le runner installe tout
# lui-meme - donc son auto-test porte seul, et il s'eprouve la ou du bash se relit.
case "$1" in 0000000000000000000000000000000000000000)
    python3 "$(git rev-parse --show-toplevel)/scripts/methode/prepare-l-environnement.py" || true
    exit 0
    ;;
esac
git diff --quiet "$1" "$2" -- src pom.xml && exit 0

echo "post-checkout : sources modifiées entre les branches, nettoyage de target/"
if ! ./mvnw -q clean >/dev/null 2>&1; then
    echo "post-checkout : nettoyage incomplet (recompilation IDE concurrente ?), relancez ./mvnw clean au besoin"
fi

exit 0
