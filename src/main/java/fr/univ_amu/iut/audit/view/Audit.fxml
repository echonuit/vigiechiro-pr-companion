<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  M-Audit - écran « Audit de cohérence » (feature audit, prisme « Collecte & passages »). Lance l'audit
  disque / base global et liste les écarts (fichiers manquants ou orphelins, préfixes non conformes,
  unités déposées divergentes). Pur câblage : le controller lie la table et le résumé à l'AuditViewModel.
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="fr.univ_amu.iut.audit.view.AuditController"
           stylesheets="@../../commun/view/palette.css, @../../commun/view/design.css"
           fx:id="hoteOccupation">
  <!-- Hôte d'occupation (#1254) : voile « … en cours » pendant la vérification en ligne. -->
  <VBox styleClass="ecran-audit" spacing="10.0">

    <HBox spacing="10.0" alignment="CENTER_LEFT">
      <Label fx:id="lblResume" styleClass="titre-section" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
      <Button fx:id="boutonRafraichir" text="Relancer l'audit" styleClass="bouton-secondaire" onAction="#rafraichir"/>
      <Button fx:id="boutonVerifierEnLigne" text="Vérifier en ligne" styleClass="bouton-secondaire" onAction="#verifierEnLigne"/>
      <!-- Audit ciblé (#1347) : après avoir réparé une nuit, on veut vérifier CELLE-LÀ, pas tout le
           workspace. Désactivé tant qu'aucun constat citant un passage n'est sélectionné (l'enveloppe
           porte l'explication : un bouton désactivé n'affiche pas d'infobulle). -->
      <StackPane fx:id="enveloppeAuditerPassage">
        <Button fx:id="boutonAuditerPassage" text="Auditer ce passage" styleClass="bouton-secondaire"
                onAction="#auditerLePassageSelectionne"/>
      </StackPane>
      <!-- Retrait des dossiers de session orphelins (#3482, ADR-3482) : la seule action de l'audit qui
           ÉCRIT sur le disque. Supprimer un passage laisse volontairement ses fichiers ; c'est ici qu'on
           les ramasse, en connaissance de cause. Le libellé porte le nombre, le clic chiffre la perte
           avant d'agir. Désactivé tant que l'audit n'a relevé aucun dossier orphelin. -->
      <StackPane fx:id="enveloppeRetirerOrphelins">
        <Button fx:id="boutonRetirerOrphelins" text="Retirer les dossiers orphelins"
                styleClass="bouton-danger" onAction="#retirerLesDossiersOrphelins"/>
      </StackPane>
    </HBox>

    <!-- Onglets de vues mémorisées (#623) : rejouer une combinaison de filtres enregistrée. -->
    <FlowPane fx:id="barreOnglets" hgap="6.0" vgap="6.0" alignment="CENTER_LEFT" styleClass="barre-onglets"/>

    <!-- Barre de filtres « à la Notion » (#3100, palier 5 du chantier #3092) : recherche permanente sur
         la cible et le détail, puces pour Gravité / Catégorie / Passage, et « Tout effacer ». Un audit
         de saison produit des constats de natures mêlées, et la question posée est toujours de la même
         forme : « qu'est-ce qui est bloquant ? », « qu'est-ce qui concerne cette nuit ? ». -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
      <TextField fx:id="champRecherche" promptText="Rechercher (cible, détail…)" minWidth="-Infinity"
                 prefWidth="300.0"/>
      <MenuButton fx:id="menuAjoutFiltre" minWidth="-Infinity" text="+ Filtre" styleClass="menu-ajout-filtre"/>
      <FlowPane fx:id="pucesFiltres" hgap="6.0" vgap="6.0" alignment="CENTER_LEFT"
                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
      <Button fx:id="boutonToutEffacer" minWidth="-Infinity" text="Tout effacer" styleClass="bouton-secondaire"
              accessibleText="Effacer tous les filtres et le tri"/>
    </HBox>

    <!-- Compte rendu des restaurations amputées (#3056/#3093) : une vue rejouée ou des filtres de
         session remis sans tout ce qu'ils portaient montrent plus large qu'annoncé. Relancer l'audit
         renouvelle les constats, donc ce cas est ici la règle plutôt que l'exception. -->
    <HBox fx:id="bandeauRetour" styleClass="bandeau-retour" alignment="CENTER_LEFT" spacing="10.0">
      <Label fx:id="lblRetour" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
      <Button fx:id="btnFermerRetour" styleClass="fermer-retour" accessibleText="Fermer le message">
        <graphic>
          <FontIcon iconLiteral="fas-times"/>
        </graphic>
      </Button>
    </HBox>

    <TableView fx:id="tableConstats" VBox.vgrow="ALWAYS">
      <columns>
        <TableColumn fx:id="colSeverite" text="Gravité" prefWidth="110.0"/>
        <TableColumn fx:id="colCategorie" text="Catégorie" prefWidth="180.0"/>
        <TableColumn fx:id="colPassage" text="Passage" prefWidth="80.0"/>
        <TableColumn fx:id="colCible" text="Cible" prefWidth="320.0"/>
        <TableColumn fx:id="colDetail" text="Détail" prefWidth="380.0"/>
      </columns>
    </TableView>
  </VBox>
</StackPane>
