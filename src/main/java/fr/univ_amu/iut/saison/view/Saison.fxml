<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.univ_amu.iut.saison.view.SaisonController"
      stylesheets="@../../commun/view/palette.css, @../../commun/view/design.css, @saison.css"
      spacing="12.0">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Saison"/>
        <ComboBox fx:id="choixAnnee"/>
        <!-- Filtre par campagne (#2610) : masqué tant qu'aucune campagne n'existe, ou si la
             fonctionnalité `campagne` est coupée. Un sélecteur qui ne propose rien n'aide personne. -->
        <Label fx:id="lblCampagne" text="Campagne"/>
        <ComboBox fx:id="choixCampagne" prefWidth="220.0"/>

        <!-- Chercher un lieu et isoler ce qui reste (#3103). Ces deux-là s'AJOUTENT aux sélecteurs
             ci-dessus, qui restent des contrôles fixes : une saison est une année et une campagne, et
             les garder toujours visibles donne la lecture immédiate « je suis sur telle saison ». Sur un
             jeu conséquent, en revanche, « où en est ce lieu ? » et « qu'est-ce qu'il me reste à
             faire ? » n'avaient aucune réponse directe. -->
        <!-- 345 px, et non 310 : à 310 le libellé tenait EN LOCAL et tronquait EN CI de 13 px. Les polices
             du runner sont plus larges que celles d'un poste de développement, et c'est l'image de la CI
             qui fait foi. La marge est donc délibérée : la raser au plus juste rouvrirait le défaut à la
             première retouche du libellé. -->
        <TextField fx:id="champRechercheLieu" promptText="Chercher un lieu (carré, nom, point, commune)"
                   minWidth="-Infinity" prefWidth="345.0"/>
        <CheckBox fx:id="caseResteAFaire" minWidth="-Infinity" text="Reste à faire"
                  accessibleText="N'afficher que les points qui ne sont pas à jour"/>
    </HBox>

    <Label fx:id="lblResume" wrapText="true"/>
    <Label fx:id="lblSignalement" styleClass="signalement-fenetre" wrapText="true" managed="false" visible="false"/>

    <TableView fx:id="tableSaison" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCarre" text="Carré" prefWidth="75.0"/>
            <TableColumn fx:id="colNomSite" text="Nom du carré" prefWidth="150.0"/>
            <TableColumn fx:id="colPoint" text="Point" prefWidth="65.0"/>
            <TableColumn fx:id="colCommune" text="Commune" prefWidth="140.0"/>
            <TableColumn fx:id="colPassage1" text="Passage 1" prefWidth="170.0"/>
            <TableColumn fx:id="colPassage2" text="Passage 2" prefWidth="170.0"/>
            <!-- Nuits réalisées sur ce point mais HORS protocole (opportunistes, #2525) : elles ne
                 prennent pas la place d'un passage attendu, qui reste « Non planifié ». -->
            <TableColumn fx:id="colHorsProtocole" text="Hors protocole" prefWidth="145.0"/>
            <TableColumn fx:id="colResteAFaire" text="Reste à faire" prefWidth="240.0"/>
        </columns>
        <placeholder>
            <Label text="Aucun point suivi pour cette saison. Déclarez un site et un point d'écoute pour commencer." wrapText="true"/>
        </placeholder>
    </TableView>
</VBox>
