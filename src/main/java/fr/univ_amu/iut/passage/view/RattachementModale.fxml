<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Modale « Modifier le passage » (E2.S8), ouverte depuis M-Passage dans un Stage modal. Regroupe en une
  fenêtre : le rattachement (année + n° de passage, deux Spinner liés au RattachementViewModel) et les
  conditions de dépôt VigieChiro (relevé météo, matériel du micro). « Appliquer » enregistre le tout
  d'un bloc ; en cas de succès la modale se ferme et rafraîchit l'écran appelant. « Annuler » ne
  persiste rien.

  #2496 : le formulaire est long (rattachement, météo, enregistreur, heures, micro). Plutôt qu'une seule
  colonne qui déborde les petits écrans - et pousse Annuler/Appliquer hors champ dès qu'un bandeau
  paraît -, le titre reste en tête, le CORPS défile dans un ScrollPane, et le bandeau de retour plus le
  pied (Annuler/Appliquer) restent ÉPINGLÉS au bas, toujours visibles. La section météo est en deux
  colonnes pour raccourcir la hauteur.
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="racine"
      fx:controller="fr.univ_amu.iut.passage.view.RattachementModaleController"
      stylesheets="@../../commun/view/palette.css, @../../commun/view/design.css, @passage.css"
      styleClass="modale-saisie"
      prefWidth="560.0"
      spacing="12.0">

  <Label text="Modifier le passage" styleClass="titre-page">
    <graphic>
      <FontIcon iconLiteral="fas-pen" styleClass="titre-page-icone"/>
    </graphic>
  </Label>

  <!-- Corps défilant (#2496) : tout le formulaire vit ici. Le pied et le bandeau, eux, sont épinglés
       après ce ScrollPane, donc jamais poussés hors de la fenêtre par la croissance du contenu. -->
  <ScrollPane styleClass="corps-modale" fitToWidth="true" hbarPolicy="NEVER"
              prefViewportHeight="500.0" VBox.vgrow="ALWAYS">
    <VBox spacing="12.0">

      <!-- Tirer les métadonnées depuis la participation VigieChiro (cas « préparé sur le site web »).
           Masqué hors connexion (visibilité pilotée par le controller selon la présence de la passerelle). -->
      <HBox fx:id="ligneSyncVigieChiro" alignment="CENTER_LEFT" spacing="8.0">
        <Button fx:id="boutonTirerVigieChiro" text="Récupérer depuis Vigie-Chiro"
                styleClass="bouton-secondaire" onAction="#tirerDepuisVigieChiro"/>
        <!-- Pendant explicite du bouton précédent (#1839) : deux boutons, deux sens, deux comptes rendus.
             Avant, l'envoi n'était qu'un effet de bord caché d'« Appliquer », qui échouait en silence. -->
        <Button fx:id="boutonEnvoyerVigieChiro" text="Envoyer vers Vigie-Chiro"
                styleClass="bouton-secondaire" onAction="#envoyerVersVigieChiro"/>
        <!-- « Importer les observations » a quitté cette modale (#1350) : elle est fermée sur un passage
             déposé (garde de renommage #1134), c'est-à-dire précisément le cas où l'import a le plus de
             sens. L'action vit désormais sur M-Passage, où aucune garde de renommage ne s'applique. -->
      </HBox>

      <!-- Repère « en cours » (#1543) : une petite roue + un libellé pendant un aller-retour VigieChiro
           (météo, synchronisation), faute de quoi seul le grisage des boutons signalait l'activité. -->
      <HBox fx:id="ligneOccupation" alignment="CENTER_LEFT" spacing="8.0">
        <ProgressIndicator prefWidth="18.0" prefHeight="18.0"/>
        <Label text="Communication avec Vigie-Chiro…" styleClass="section-sous"/>
      </HBox>

      <!-- Rattachement : année + n° de passage (le site et le point ne changent pas). -->
      <Label text="Rattachement" styleClass="section-sous"/>
      <Label text="Corrige l'année et/ou le n° de passage. Le site et le point ne changent pas."
             styleClass="section-sous" wrapText="true"/>
      <HBox spacing="24.0">
        <VBox spacing="4.0">
          <Label text="Année" styleClass="bandeau-label"/>
          <Spinner fx:id="spinnerAnnee" editable="true" prefWidth="130.0"/>
        </VBox>
        <VBox spacing="4.0">
          <Label text="N° de passage" styleClass="bandeau-label"/>
          <Spinner fx:id="spinnerNumero" editable="true" prefWidth="110.0"/>
        </VBox>
      </HBox>
      <!-- Passage déposé (#1134) : renommage verrouillé, mais météo/micro restent éditables. Indice masqué sinon. -->
      <Label fx:id="indiceRenommageVerrouille"
             text="Passage déposé : l'année et le n° sont verrouillés (identité serveur). Vous pouvez ajuster la météo et le micro ci-dessous."
             styleClass="section-sous" wrapText="true"/>

      <!-- Rattachement facultatif à une campagne (#2355). Ligne masquée si la feature `campagne` est coupée. -->
      <HBox fx:id="ligneCampagne" spacing="24.0">
        <VBox spacing="4.0">
          <Label text="Campagne" styleClass="bandeau-label"/>
          <!-- Le bouton est À CÔTÉ de la liste, et non une entrée DEDANS (#2630) : la liste porte déjà
               une sentinelle « aucune campagne », et une seconde entrée qui, elle, ouvrirait une fenêtre
               rendrait la sélection ambiguë. -->
          <HBox spacing="8.0" alignment="CENTER_LEFT">
            <ComboBox fx:id="champCampagne" prefWidth="260.0" maxWidth="Infinity"/>
            <Button fx:id="btnGererCampagnes" text="Gérer…" onAction="#gererCampagnes"/>
          </HBox>
        </VBox>
      </HBox>

      <!-- Nature opportuniste (#2525) : passage réalisé sur le carré d'un tiers, exempté de R3/R4 (ni
           contrainte de date, ni de fréquence). Toujours présent, notamment pour une participation non
           connectée où la dérivation automatique côté API est impossible. -->
      <CheckBox fx:id="caseOpportuniste" wrapText="true"
                text="Participation opportuniste (carré d'un tiers : sans contrainte de date ni de fréquence)"/>

      <Separator/>

      <!-- Conditions météo (optionnel) : grandeurs éditables (vide pour effacer). Deux colonnes (#2496) :
           températures à gauche, vent/couverture à droite, libellé au-dessus du champ pour tenir en largeur. -->
      <Label text="Conditions météo (optionnel)" styleClass="section-sous"/>
      <GridPane hgap="24.0" vgap="10.0">
        <VBox spacing="4.0" GridPane.rowIndex="0" GridPane.columnIndex="0">
          <Label text="Température début (°C)" styleClass="bandeau-label"/>
          <TextField fx:id="champTemperature" promptText="ex. 8,5" prefWidth="150.0"/>
        </VBox>
        <VBox spacing="4.0" GridPane.rowIndex="0" GridPane.columnIndex="1">
          <Label text="Vent" styleClass="bandeau-label"/>
          <ComboBox fx:id="champVent" prefWidth="200.0" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4.0" GridPane.rowIndex="1" GridPane.columnIndex="0">
          <Label text="Température fin (°C)" styleClass="bandeau-label"/>
          <TextField fx:id="champTemperatureFin" promptText="ex. 5,0" prefWidth="150.0"/>
        </VBox>
        <VBox spacing="4.0" GridPane.rowIndex="1" GridPane.columnIndex="1">
          <Label text="Couverture nuageuse" styleClass="bandeau-label"/>
          <ComboBox fx:id="champCouverture" prefWidth="200.0" maxWidth="Infinity"/>
        </VBox>
      </GridPane>
      <HBox alignment="CENTER_LEFT">
        <Button fx:id="boutonRecupererMeteo" text="Récupérer la météo"
                styleClass="bouton-secondaire" onAction="#recupererMeteo"/>
      </HBox>

      <Separator/>

      <!-- Enregistreur (#1828) : liste ÉDITABLE. Les propositions viennent des noms de fichiers de la nuit
           (journal LogPR<serie>, originaux PaRecPR<serie>) puis des enregistreurs déjà connus du poste ;
           l'utilisateur peut aussi taper le numéro lu sur l'appareil. Vide = on ne sait pas. -->
      <Label text="Enregistreur" styleClass="section-sous"/>
      <GridPane hgap="10.0" vgap="8.0">
        <Label text="N° de série :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="champEnregistreur" editable="true" prefWidth="220.0"
                  promptText="ex. 1925492" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
      </GridPane>
      <Label text="Laissez vide si vous l'ignorez : la nuit restera « inconnue » plutôt que de porter un faux numéro."
             styleClass="aide-champ" wrapText="true"/>

      <Separator/>

      <!-- Heures de la nuit (#1892) : saisissables SEULEMENT quand aucun enregistrement ne les atteste.
           Dès que la nuit se prouve (fichiers ou séquences), ce sont eux qui font foi (#1878) et les champs
           passent en lecture seule - accepter une saisie serait la trahir, l'envoi la remplacerait. -->
      <Label text="Heures de la nuit" styleClass="section-sous"/>
      <GridPane hgap="10.0" vgap="8.0">
        <Label text="Début :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="champHeureDebut" promptText="ex. 21:00" prefWidth="90.0"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Fin :" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="champHeureFin" promptText="ex. 06:00" prefWidth="90.0"
                   GridPane.rowIndex="0" GridPane.columnIndex="3"/>
      </GridPane>
      <Label fx:id="aideHeures" styleClass="aide-champ" wrapText="true"/>

      <Separator/>

      <!-- Matériel du micro (optionnel, dépôt VigieChiro) : position + type en listes fermées. -->
      <Label text="Matériel du micro (optionnel)" styleClass="section-sous"/>
      <GridPane hgap="10.0" vgap="8.0">
        <Label text="Position :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="champPosition" prefWidth="220.0"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Hauteur :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="champHauteur" promptText="ex. 4" prefWidth="90.0"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="m" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

        <Label text="Type de micro :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="champTypeMicro" prefWidth="220.0"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>
      </GridPane>

      <Separator/>

      <Label fx:id="labelRecap" styleClass="recap-rattachement" wrapText="true"/>
    </VBox>
  </ScrollPane>

  <!-- Bandeau de retour partagé (ADR 0023), ÉPINGLÉ (#2496) : le canal s'appelait « messageErreur » alors
       qu'il portait aussi des succès et des guidages de saisie (#1917). Hors du corps défilant, un message
       révélé reste toujours visible sans repousser le pied. -->
  <HBox fx:id="bandeauRetour" styleClass="bandeau-retour" alignment="CENTER_LEFT" spacing="10.0">
    <Label fx:id="lblRetour" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    <Button fx:id="btnFermerRetour" styleClass="fermer-retour" accessibleText="Fermer le message">
      <graphic>
        <FontIcon iconLiteral="fas-times"/>
      </graphic>
    </Button>
  </HBox>

  <!-- Pied ÉPINGLÉ (#2496) : Annuler/Appliquer restent au bas de la fenêtre quel que soit le contenu. -->
  <HBox alignment="CENTER_RIGHT" spacing="8.0">
    <Region HBox.hgrow="ALWAYS"/>
    <Button text="Annuler" styleClass="bouton-secondaire" onAction="#annuler"/>
    <!-- Enveloppe porteuse de l'infobulle (#1970) : un Button désactivé n'affiche pas de tooltip. -->
    <StackPane fx:id="enveloppeAppliquer">
      <Button fx:id="boutonAppliquer" text="Appliquer" styleClass="bouton-primaire" onAction="#appliquer"/>
    </StackPane>
  </HBox>
</VBox>
