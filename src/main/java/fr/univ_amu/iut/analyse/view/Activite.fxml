<?xml version="1.0" encoding="UTF-8"?>

<?import fr.univ_amu.iut.commun.view.GrapheNocturne?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  M-Activite - courbe d'activité horaire d'une nuit (#2352, lot 2 du chantier #2348). Atteint depuis la
  carte « Activité de la nuit » de M-Passage via le contrat socle OuvrirActivite. Pur câblage : tout est
  lié à l'ActiviteViewModel par ActiviteController (courbe par espèce sur l'axe nocturne 18h vers 8h,
  sélecteur de tranche et d'espèces).
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.univ_amu.iut.analyse.view.ActiviteController"
      stylesheets="@../../commun/view/palette.css, @../../commun/view/design.css, @activite.css"
      styleClass="ecran-activite"
      spacing="14.0">

  <!-- Onglets de vues mémorisées (socle GestionnaireVues, #623) : les vues par défaut partitionnent les
       taxons par catégorie du référentiel (Chiroptères, Orthoptères, Autres, Tout), l'utilisateur pouvant
       enregistrer les siennes. Tadarida ne détecte pas que des chauves-souris. -->
  <FlowPane fx:id="barreOnglets" hgap="6.0" vgap="6.0" alignment="CENTER_LEFT" styleClass="barre-onglets"/>

  <!-- Barre de filtres (patron « à la Notion », socle Filtres) : recherche permanente, menu « + Filtre »
       (Carré, Taxon parent) et puces des filtres actifs. Le sous-ensemble filtré est ré-agrégé en direct. -->
  <HBox spacing="8.0" alignment="CENTER_LEFT" styleClass="barre-filtres">
    <TextField fx:id="champRecherche" promptText="Rechercher (espèce, carré…)" minWidth="-Infinity" prefWidth="300.0"/>
    <MenuButton fx:id="menuAjoutFiltre" minWidth="-Infinity" text="+ Filtre" styleClass="menu-ajout-filtre"/>
    <FlowPane fx:id="pucesFiltres" hgap="6.0" vgap="6.0" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"/>
    <Button fx:id="boutonToutEffacer" minWidth="-Infinity" text="Tout effacer"
            accessibleText="Effacer tous les filtres"/>
  </HBox>

  <!-- Barre de réglages : largeur de tranche horaire (15 / 30 / 60 min) et export de l'image. L'export
       redessine le graphe hors écran (jamais une capture) et l'estampille de son contexte. -->
  <HBox alignment="CENTER_LEFT" spacing="10.0">
    <Label text="Tranche horaire" styleClass="section-sous"/>
    <ChoiceBox fx:id="choixTranche"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="boutonExporterDonnees" minWidth="-Infinity" text="Exporter les données…" onAction="#exporterDonnees">
      <graphic>
        <FontIcon iconLiteral="fas-file-csv"/>
      </graphic>
    </Button>
    <Button fx:id="boutonExporterImage" minWidth="-Infinity" text="Exporter l'image…" onAction="#exporterImage">
      <graphic>
        <FontIcon iconLiteral="fas-file-image"/>
      </graphic>
    </Button>
  </HBox>

  <!-- Sélecteur d'espèces : une case par espèce de la nuit ; les cinq plus contactées sont cochées par
       défaut. Au-delà de cinq courbes, le graphe devient illisible. -->
  <Label fx:id="lblTitreEspeces" text="Espèces" styleClass="section-sous"/>
  <FlowPane fx:id="selecteurEspeces" hgap="14.0" vgap="6.0"/>

  <!-- Courbe : une série par espèce sélectionnée, sur l'axe nocturne fixe 18h vers 8h (étiquettes HH
       reconstruites par le controller). GrapheNocturne matérialise en plus la fenêtre coucher -> lever
       par un aplat pâle derrière les courbes. -->
  <GrapheNocturne fx:id="grapheActivite" VBox.vgrow="ALWAYS" minHeight="280.0" legendVisible="true" animated="false">
    <xAxis>
      <NumberAxis label="Heure"/>
    </xAxis>
    <yAxis>
      <NumberAxis label="Contacts"/>
    </yAxis>
  </GrapheNocturne>

  <!-- Bandeau de retour d'opération (export réussi ou échoué), mutualisé avec Analyse et Sons &
       validation : style dans commun/view/design.css, câblage dans commun/view/BandeauRetour. -->
  <HBox fx:id="bandeauRetour" styleClass="bandeau-retour" alignment="CENTER_LEFT" spacing="10.0">
    <Label fx:id="lblRetour" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    <Button fx:id="btnFermerRetour" styleClass="fermer-retour" accessibleText="Fermer le message">
      <graphic>
        <FontIcon iconLiteral="fas-times"/>
      </graphic>
    </Button>
  </HBox>

  <!-- État vide (#2352) : une nuit sans espèce détectée le dit, plutôt qu'un graphe vide muet. -->
  <Label fx:id="lblEtatVide" styleClass="encart" wrapText="true"
         text="Aucune activité à afficher : aucune espèce n'a été détectée cette nuit."/>

  <padding>
    <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
  </padding>
</VBox>
