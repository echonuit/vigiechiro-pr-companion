<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Détail : observations de l'espèce sélectionnée, à travers les passages. Sous-vue depuis #2745.

  Pourquoi une vue à part : AnalyseController vivait à 197 pour un plafond NcssCount de 200, et ce
  panneau portait à lui seul quinze champs @FXML et leur câblage.
  Voir dev-docs/decisions/2745-une-vue-riche-se-decoupe-en-sous-vues.md.

  Le parent RETIRE ce panneau du SplitPane hors regroupement « Par espèce » : il a donc besoin du
  nœud autant que du controller. L'inclusion garde le fx:id `panneauDetail`, si bien que le champ du
  parent et sa méthode d'affichage n'ont pas eu à changer.
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.univ_amu.iut.analyse.view.DetailObservationsController"
      styleClass="analyse-detail" spacing="8.0">
  <HBox alignment="CENTER_LEFT" spacing="10.0">
    <Label fx:id="lblDetailTitre" styleClass="analyse-detail-titre"/>
    <Region HBox.hgrow="ALWAYS"/>
    <!-- Enveloppes : un Button désactivé n'affiche pas de Tooltip, on le pose sur ce StackPane (#789). -->
    <StackPane fx:id="enveloppeEcouter">
      <Button fx:id="boutonEcouter" text="Écouter / valider" styleClass="bouton-secondaire" onAction="#ecouterValider">
        <graphic>
          <FontIcon iconLiteral="fas-headphones"/>
        </graphic>
      </Button>
    </StackPane>
    <StackPane fx:id="enveloppeOuvrirPassage">
      <Button fx:id="boutonOuvrirPassage" text="Ouvrir le passage" styleClass="bouton-secondaire" onAction="#ouvrirPassage">
        <graphic>
          <FontIcon iconLiteral="fas-arrow-right"/>
        </graphic>
      </Button>
    </StackPane>
  </HBox>
  <StackPane VBox.vgrow="ALWAYS">
    <TableView fx:id="tableObservations">
      <columns>
        <TableColumn fx:id="colObsPassage" text="Passage" prefWidth="160.0"/>
        <TableColumn fx:id="colObsCarre" text="Carré" prefWidth="90.0"/>
        <TableColumn fx:id="colObsRichesse" text="Espèces du carré" prefWidth="155.0"/>
        <TableColumn fx:id="colObsPoint" text="Point" prefWidth="70.0"/>
        <!-- Commune (#3165) : sur CETTE table seulement. Les tables Espèces et Carrés
             agrègent plusieurs points, et un carré de 2 km peut chevaucher deux communes :
             une cellule unique y mentirait. -->
        <TableColumn fx:id="colObsCommune" text="Commune" prefWidth="140.0"/>
        <TableColumn fx:id="colObsTadarida" text="Proposition Tadarida" prefWidth="180.0"/>
        <TableColumn fx:id="colObsObservateur" text="Votre taxon" prefWidth="150.0"/>
        <TableColumn fx:id="colObsStatut" text="Statut" prefWidth="110.0"/>
      </columns>
    </TableView>
    <Label fx:id="lblDetailVide" styleClass="analyse-detail-vide" wrapText="true"
           text="Sélectionnez une espèce dans l'inventaire (regroupement « Par espèce ») pour lister ses observations à travers les passages."/>
  </StackPane>
  <Label text="Astuce : double-cliquez une ligne pour ouvrir la fiche de l'espèce." styleClass="section-sous"/>
</VBox>
